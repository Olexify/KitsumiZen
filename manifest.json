{
  "manifest_version": 3,
  "name": "KitsumiZen",
  "version": "1.0.0",
  "description": "Hide the YouTube player UI and leave only the video. Clean footage for screen recording, presentations and screenshots.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "action": {
    "default_title": "KitsumiZen",
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/embed/*"],
      "css": ["src/zen.css"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "kitsumizen@olexify.github.io", "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] } }
  }
}
